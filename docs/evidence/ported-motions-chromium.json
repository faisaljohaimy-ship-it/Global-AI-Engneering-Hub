   "motions": [
    {
     "id": "neural-synapse-activation",
     "name_en": "Neural Synapse Activation",
     "name_ar": "تنشيط المشابك العصبية",
     "engine": "canvas2d",
     "meaning": {
      "en": "An artificial neuron in an AI model: input signals add up, and only when their sum crosses the threshold does the neuron fire an output.",
      "ar": "خلية عصبية اصطناعية في نموذج ذكاء اصطناعي: تتجمع إشارات المدخلات، ولا تُطلق الخلية مخرجها إلا حين يتجاوز مجموعها العتبة."
     }
    },
    {
     "id": "neural-signal-propagation",
     "name_en": "Neural Signal Propagation",
     "name_ar": "انتشار الإشارة العصبية",
     "engine": "canvas2d",
     "meaning": {
      "en": "A forward pass through a neural network: the input activates each layer in turn until the signal reaches the output layer.",
      "ar": "تمريرة أمامية عبر شبكة عصبية: يُنشّط المُدخل كل طبقة بدورها حتى تبلغ الإشارة طبقة المخرجات."
     }
    },
    {
     "id": "neural-thought-flow",
     "name_en": "AI Thought Flow Visualization",
     "name_ar": "تصوير تدفق الأفكار",
     "engine": "canvas2d",
     "meaning": {
      "en": "An AI assistant weighs several candidate answers in parallel, scoring each one before it settles on a single output.",
      "ar": "مساعد ذكاء اصطناعي يوازن عدة إجابات مرشّحة في وقت واحد، ويقيّم كلًّا منها قبل أن يستقر على مخرج واحد."
     }
    },
    {
     "id": "neural-multi-agent-communication",
     "name_en": "Multi-Agent Communication",
     "name_ar": "اتصالات الوكلاء المتعددين",
     "engine": "canvas2d",
     "meaning": {
      "en": "AI agents for planning, building, testing and review pass requests and replies to one another to hand the work along.",
      "ar": "وكلاء ذكاء اصطناعي للتخطيط والبناء والاختبار والمراجعة يتبادلون الطلبات والردود لتسليم العمل فيما بينهم."
     }
    },
    {
     "id": "neural-network-growth",
     "name_en": "Neural Network Growth",
     "name_ar": "نمو الشبكة العصبية",
     "engine": "canvas2d",
     "meaning": {
      "en": "Network rollout: starting from the core node, each new node comes online through a node that is already connected.",
      "ar": "توسيع الشبكة: بدءًا من العقدة الأساسية، تنضم كل عقدة جديدة عبر عقدة متصلة من قبل."
     }
    },
    {
     "id": "neural-decision-tree",
     "name_en": "AI Decision Tree Animation",
     "name_ar": "حركة شجرة القرار",
     "engine": "canvas2d",
     "meaning": {
      "en": "A decision-tree model routes a case by its score: it takes the low or high branch at the rule and ends at one outcome.",
      "ar": "نموذج شجرة قرار يوجّه الحالة بحسب درجتها: يسلك الفرع المنخفض أو المرتفع عند القاعدة وينتهي إلى نتيجة واحدة."
     }
    },
    {
     "id": "neural-attention-matrix",
     "name_en": "Attention Matrix Visualization",
     "name_ar": "تصوير مصفوفة الانتباه",
     "engine": "canvas2d",
     "meaning": {
      "en": "Attention in a language model: for each token the model weighs every other token, and the strongest weight shows what it attends to.",
      "ar": "الانتباه في نموذج لغوي: يزن النموذج لكل رمز جميع الرموز الأخرى، وتُظهر أعلى الأوزان ما يركّز عليه."
     }
    },
    {
     "id": "networks-node-network-3d",
     "name_en": "Three-dimensional Node Network",
     "name_ar": "شبكة عقد ثلاثية الأبعاد",
     "engine": "canvas2d",
     "meaning": {
      "en": "A server cluster's interconnect in 3D: eight servers wired as a cube, each linked to three neighbours, inspected from every side.",
      "ar": "شبكة ربط عنقود خوادم بثلاثة أبعاد: ثمانية خوادم موصولة على هيئة مكعب، كلٌّ منها مرتبط بثلاثة جيران، تُفحص من كل جانب."
     }
    },
    {
     "id": "networks-reconfiguration",
     "name_en": "Dynamic Network Reconfiguration",
     "name_ar": "إعادة تشكيل الشبكة ديناميكيًا",
     "engine": "canvas2d",
     "meaning": {
      "en": "Network re-architecture: a ring of point-to-point links is retired, and every node reconnects through one central hub.",
      "ar": "إعادة هندسة الشبكة: تُستبدل حلقة الروابط المباشرة بين العقد، وتعيد كل عقدة اتصالها عبر محور مركزي واحد."
     }
    },
    {
     "id": "networks-geographic-connection",
     "name_en": "Geographic Network Connection",
     "name_ar": "ربط الشبكات جغرافيًا",
     "engine": "canvas2d",
     "meaning": {
      "en": "Cross-region connectivity: data packets travel between data centres in different regions of a schematic world map.",
      "ar": "الربط بين المناطق: تنتقل حزم البيانات بين مراكز بيانات في مناطق مختلفة على خريطة عالم تخطيطية."
     }
    },
    {
     "id": "networks-relationship-mapping",
     "name_en": "Spatial Relationship Mapping",
     "name_ar": "رسم العلاقات المكانية",
     "engine": "canvas2d",
     "meaning": {
      "en": "Data mapping between two systems: records on one side link to related records on the other, and each link's weight shows how strong the relation is.",
      "ar": "مطابقة البيانات بين نظامين: ترتبط السجلات في جهة بالسجلات المقابلة في الجهة الأخرى، ويُظهر وزن كل رابط قوة العلاقة."
     }
    },
    {
     "id": "networks-agent-constellation",
     "name_en": "Agent Collaboration Constellation",
     "name_ar": "كوكبة تعاون الوكلاء",
     "engine": "canvas2d",
     "meaning": {
      "en": "AI agent teams collaborate: three groups of agents converge through their leads, and a task passes from team to team around the cycle.",
      "ar": "تعاون فرق وكلاء الذكاء الاصطناعي: تتقارب ثلاث مجموعات عبر قادتها، وتنتقل المهمة من فريق إلى آخر في دورة."
     }
    },
    {
     "id": "networks-dependency-animation",
     "name_en": "Infrastructure Dependency Animation",
     "name_ar": "حركة تبعيات البنية التحتية",
     "engine": "canvas2d",
     "meaning": {
      "en": "Infrastructure start-up in dependency order: base, core and data services come up first, then the API and cache, and the page last.",
      "ar": "تشغيل البنية التحتية بترتيب التبعيات: تعمل الخدمات الأساسية والنواة والبيانات أولًا، ثم الواجهة البرمجية والذاكرة المؤقتة، والصفحة أخيرًا."
     }
    },
    {
     "id": "networks-hierarchical-expansion",
     "name_en": "Hierarchical Network Expansion",
     "name_ar": "تمدد الشبكة الهرمية",
     "engine": "canvas2d",
     "meaning": {
      "en": "A hierarchical network unfolds: the root connects regional hubs, and each hub then brings its own endpoints online.",
      "ar": "تمدد شبكة هرمية: يربط الجذر محاور إقليمية، ثم يُشغّل كل محور نقاط النهاية التابعة له."
     }
    },
    {
     "id": "networks-signal-routing",
     "name_en": "Network Signal Routing",
     "name_ar": "توجيه الإشارات في الشبكة",
     "engine": "canvas2d",
     "meaning": {
      "en": "Network routing: a data packet takes the shortest path around unavailable nodes to reach its destination.",
      "ar": "توجيه الشبكة: تسلك حزمة البيانات أقصر مسار متجاوزةً العقد غير المتاحة حتى تبلغ وجهتها."
     }
    }

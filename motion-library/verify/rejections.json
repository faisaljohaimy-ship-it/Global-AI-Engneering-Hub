{
  "notes": "Each case sets one value in specs/fade-in.json; the compiler and the runtime must both refuse the result.",
  "cases": [
    {
      "case": "offsets out of order",
      "path": [
        "keyframes",
        0,
        "offset"
      ],
      "value": 1
    },
    {
      "case": "declaration injection",
      "path": [
        "keyframes",
        0,
        "opacity"
      ],
      "value": "0; color: red"
    },
    {
      "case": "remote fetch",
      "path": [
        "reduced_motion",
        "background-color"
      ],
      "value": "url(https://example.com/x)"
    },
    {
      "case": "custom property",
      "path": [
        "keyframes",
        0,
        "transform"
      ],
      "value": "translateX(var(--x))"
    },
    {
      "case": "unsupported property",
      "path": [
        "keyframes",
        0,
        "width"
      ],
      "value": "10px"
    },
    {
      "case": "matrix transform",
      "path": [
        "keyframes",
        0,
        "transform"
      ],
      "value": "matrix(1, 0, 0, 1, 0, 0)"
    },
    {
      "case": "drop-shadow filter",
      "path": [
        "keyframes",
        0,
        "filter"
      ],
      "value": "drop-shadow(0px 0px 2px #000)"
    },
    {
      "case": "named colour",
      "path": [
        "keyframes",
        0,
        "color"
      ],
      "value": "red"
    },
    {
      "case": "opacity as text",
      "path": [
        "keyframes",
        0,
        "opacity"
      ],
      "value": "0.5"
    },
    {
      "case": "opacity out of range",
      "path": [
        "keyframes",
        0,
        "opacity"
      ],
      "value": 2
    },
    {
      "case": "identifier",
      "path": [
        "id"
      ],
      "value": "Bad Id"
    },
    {
      "case": "zero duration",
      "path": [
        "duration_ms"
      ],
      "value": 0
    },
    {
      "case": "boolean duration",
      "path": [
        "duration_ms"
      ],
      "value": true
    },
    {
      "case": "boolean offset",
      "path": [
        "keyframes",
        0,
        "offset"
      ],
      "value": false
    },
    {
      "case": "easing function",
      "path": [
        "easing"
      ],
      "value": "steps(2)"
    },
    {
      "case": "empty reduced state",
      "path": [
        "reduced_motion"
      ],
      "value": {}
    },
    {
      "case": "non-boolean rtl_mirror",
      "path": [
        "rtl_mirror"
      ],
      "value": "yes"
    },
    {
      "case": "schema version",
      "path": [
        "schema_version"
      ],
      "value": 2
    }
  ]
}

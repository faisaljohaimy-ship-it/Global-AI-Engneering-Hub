{
  "schema_version": 1,
  "id": "ui-hover-lift",
  "name": "Hover lift",
  "duration_ms": 180,
  "easing": "ease-out",
  "keyframes": [
    {"offset": 0, "transform": "translateY(0px)", "filter": "drop-shadow(0px 0px 0px rgba(0, 0, 0, 0))"},
    {"offset": 1, "transform": "translateY(-4px)", "filter": "drop-shadow(0px 8px 12px rgba(15, 23, 42, 0.18))"}
  ],
  "reduced_motion": {"transform": "none", "filter": "drop-shadow(0px 8px 12px rgba(15, 23, 42, 0.18))"}
}

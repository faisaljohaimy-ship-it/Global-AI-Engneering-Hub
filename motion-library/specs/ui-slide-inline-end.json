{
  "schema_version": 1,
  "id": "ui-slide-inline-end",
  "name": "Slide inline end",
  "duration_ms": 280,
  "easing": "ease-out",
  "direction": "Enters from the inline-end edge: the right in LTR, the left in RTL.",
  "keyframes": [
    {"offset": 0, "opacity": 0, "transform": "translateX(calc(var(--hub-inline-sign, 1) * 24px))"},
    {"offset": 1, "opacity": 1, "transform": "translateX(0px)"}
  ],
  "reduced_motion": {"opacity": 1, "transform": "none"}
}

{
  "schema": "gaie.lexicon/1",
  "version": 1,
  "note": "Shared bilingual lexicon of the requirements engine (engineering_os/requirements.py). Arabic keywords are written without the article ال (the matcher strips it and the و/ف/ب/ل/ك/لل prefixes from the command, not from the keyword); spelling variants of hamza, alef, taa marbuta and diacritics are folded by the router normalization.",
  "control": {
    "negations": {"ar": ["بدون", "دون", "بلا", "لا", "ليس", "عدا", "باستثناء", "ماعدا"],
                  "en": ["without", "no", "not", "except", "excluding", "dont"]},
    "new": {"ar": ["جديد", "جديدة", "جديدًا", "من الصفر"], "en": ["new", "from scratch"]},
    "add": {"ar": ["أضف", "أضيفي", "ضف", "زوّد", "أدرج"], "en": ["add", "include", "introduce"]},
    "remove": {"ar": ["احذف", "أزل", "ألغِ", "اشطب"], "en": ["remove", "delete", "drop"]},
    "change": {"ar": ["عدّل", "غيّر", "طوّر", "وسّع"], "en": ["change", "modify", "update", "upgrade", "improve", "extend", "enhance"]},
    "coordinators": {"ar": ["ثم", "و", "كذلك", "أيضا"], "en": ["and", "then", "also", "please"]}
  },

  "features": [
    {"id": "search", "title": {"ar": "البحث في {label_ar}", "en": "Search {label_en}"},
     "keywords": {"ar": ["بحث", "ابحث"], "en": ["search", "find"]}, "needs": [],
     "acceptance": [
       {"en": "GET /api/{plural}?q=alpha returns 200 and only records whose text fields contain alpha",
        "ar": "البحث عن alpha في {label_ar} يعيد 200 والسجلات التي تحتوي حقولها النصية على alpha فقط"},
       {"en": "GET /api/{plural}?q= returns 200 and all records",

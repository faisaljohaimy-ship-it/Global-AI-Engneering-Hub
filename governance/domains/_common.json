     "acceptance": [
       {"en": "GET /api/{plural}.csv returns 200 and text/csv content with a header row and one row per record",
        "ar": "تصدير {label_ar} يعيد 200 وملف text/csv بصف عناوين وصف لكل سجل"},
       {"en": "GET /api/{plural}.csv without a session returns 401",
        "ar": "التصدير بدون جلسة دخول يعيد 401"}]},
    {"id": "csv-import", "title": {"ar": "استيراد {label_ar} من CSV", "en": "Import {label_en} from CSV"},

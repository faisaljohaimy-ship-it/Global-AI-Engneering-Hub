     "acceptance": [
       {"en": "POST /api/{plural}/import with a valid CSV file returns 201 and the number of created records",
        "ar": "استيراد ملف CSV صحيح يعيد 201 وعدد السجلات المنشأة"},
       {"en": "POST /api/{plural}/import with a row missing {required_field} returns 400 and the row number",
        "ar": "استيراد ملف فيه صف ينقصه «{required_field_ar}» يعيد 400 ورقم الصف"}]},
    {"id": "notifications", "title": {"ar": "إشعارات {label_ar}", "en": "{label_en} notifications"},
     "keywords": {"ar": ["إشعار", "إشعارات", "تنبيه", "تنبيهات"], "en": ["notification", "notifications", "alert", "alerts", "notify"]},
     "needs": ["enum_field"],
     "acceptance": [
       {"en": "PATCH /api/{plural}/{id} with a new {enum_field} returns 200 and a notification readable at GET /api/notifications",
        "ar": "تغيير «{enum_field_ar}» في {label_ar} يعيد 200 وينشئ إشعارًا يظهر في GET /api/notifications"},
       {"en": "GET /api/notifications returns 200 and only the signed-in user's notifications",
        "ar": "عرض الإشعارات يعيد 200 وإشعارات المستخدم الحالي فقط"},
       {"en": "PATCH /api/notifications/{id} with read=true returns 200 and the notification marked read",
        "ar": "تعليم الإشعار كمقروء يعيد 200"}]},
    {"id": "reports", "title": {"ar": "تقارير {label_ar}", "en": "{label_en} reports"},
     "keywords": {"ar": ["تقرير", "تقارير", "إحصائيات", "إحصاءات"], "en": ["report", "reports", "reporting", "statistics", "analytics"]},
     "needs": ["enum_field"],
     "acceptance": [
       {"en": "GET /api/reports/{plural}-by-{enum_field} returns 200 and a count per {enum_field} value that sums to the number of {plural}",
        "ar": "تقرير {label_ar} حسب «{enum_field_ar}» يعيد 200 وعددًا لكل قيمة مجموعه يساوي عدد السجلات"}]},
    {"id": "dashboard", "title": {"ar": "لوحة متابعة {label_ar}", "en": "{label_en} dashboard"},
     "keywords": {"ar": ["لوحة تحكم", "لوحة متابعة", "لوحة معلومات"], "en": ["dashboard", "overview"]},
     "needs": ["enum_field"],
     "acceptance": [
       {"en": "GET /api/dashboard returns 200 and the count of {plural} per {enum_field}",
        "ar": "لوحة المتابعة تعيد 200 وعدد {label_ar} لكل قيمة من «{enum_field_ar}»"},
       {"en": "GET /dashboard returns 200 and html",
        "ar": "صفحة لوحة المتابعة تعيد 200 وصفحة HTML"}]},
    {"id": "attachments", "title": {"ar": "مرفقات {label_ar}", "en": "{label_en} attachments"},
     "keywords": {"ar": ["مرفق", "مرفقات", "رفع ملفات", "رفع الملفات", "صور"], "en": ["attachment", "attachments", "upload", "file upload", "photos"]},
     "needs": [],
     "acceptance": [
       {"en": "POST /api/{plural}/{id}/attachments with a file up to 5 MB returns 201 and the attachment metadata",
        "ar": "رفع ملف حتى 5 ميغابايت إلى {label_ar} يعيد 201 وبيانات المرفق"},
       {"en": "POST /api/{plural}/{id}/attachments with a file larger than 5 MB returns 413",
        "ar": "رفع ملف أكبر من 5 ميغابايت يعيد 413"},
       {"en": "GET /api/{plural}/{id}/attachments returns 200 and the uploaded attachments",
        "ar": "عرض المرفقات يعيد 200 والملفات المرفوعة"}]},
    {"id": "audit-log", "title": {"ar": "سجل تدقيق {label_ar}", "en": "{label_en} audit log"},
     "keywords": {"ar": ["سجل تدقيق", "سجل تغييرات", "سجل التعديلات", "تتبع التغييرات"], "en": ["audit log", "audit trail", "change history", "audit"]},
     "needs": [],
     "acceptance": [
       {"en": "PATCH /api/{plural}/{id} with a valid body returns 200 and an entry at GET /api/audit naming the user, the record and the changed fields",
        "ar": "تعديل {label_ar} يعيد 200 ويضيف قيدًا في سجل التدقيق باسم المستخدم والسجل والحقول المعدلة"},
       {"en": "DELETE /api/audit/{id} as admin returns 405",
        "ar": "حذف قيد من سجل التدقيق حتى بصلاحية المدير يعيد 405"}]}

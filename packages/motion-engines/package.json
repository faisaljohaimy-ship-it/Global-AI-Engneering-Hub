{
  "name": "@global-ai-hub/motion-engines",
  "version": "1.0.0",
  "description": "The named motions, each on its real engine (GLSL, WGSL, GPU particles, DOM, SVG, Canvas 2D, compositions) behind one instance API, each proven in a browser. No runtime dependencies.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.mjs",
    "./core/*": "./core/*",
    "./engines/*": "./engines/*",
    "./shaders/*": "./shaders/*",
    "./motions/*": "./motions/*",
    "./adapters/*": "./adapters/*",
    "./orchestrator": "./orchestrator.mjs",
    "./registry.json": "./registry.json"
  },
  "bin": { "hub-engine-motion": "./cli.mjs" },
  "scripts": {
    "registry": "node tools/build_registry.mjs",
    "verify": "node verify/browser.mjs",
    "test": "node --test test/"
  },
  "engines": { "node": ">=20" }
}

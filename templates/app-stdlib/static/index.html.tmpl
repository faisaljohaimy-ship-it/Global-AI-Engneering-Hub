<!doctype html>
<html lang="@@LANG@@" dir="@@DIR@@">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>@@TITLE@@</title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/static/app.css">
<script src="/static/app.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main" id="skip-link">@@SKIP@@</a>
<header class="topbar">
  <h1 id="app-title">@@TITLE@@</h1>
  <div class="lang-switch" role="group" aria-labelledby="lang-label">
    <span id="lang-label" class="visually-hidden">@@LANGUAGE@@</span>
    <div id="lang-buttons"></div>
  </div>
</header>
<nav id="entity-nav" class="entity-nav" aria-label="@@SECTIONS@@"></nav>
<main id="main" tabindex="-1">
  <h2 id="entity-title"></h2>
  <div id="alert" class="alert" role="alert"></div>
  <div id="status" class="status" role="status" aria-live="polite"></div>
  <section class="panel" aria-labelledby="form-title">
    <h3 id="form-title"></h3>
    <form id="record-form" class="record-form"></form>
  </section>
  <section class="panel" aria-labelledby="list-title">
    <h3 id="list-title"></h3>
    <div class="table-wrap" id="table-wrap" tabindex="0" role="region" aria-labelledby="list-title">
      <table id="records"><caption id="records-caption" class="visually-hidden"></caption><thead></thead><tbody></tbody></table>
    </div>
    <p id="empty" class="empty" hidden></p>
  </section>
</main>
<footer class="footer"><p id="footer-note">@@FOOTER@@</p></footer>
<noscript><p>@@NOSCRIPT@@</p></noscript>
</body>
</html>
